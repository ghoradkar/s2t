<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:orientation="vertical">


    <androidx.cardview.widget.CardView
        android:id="@+id/cv_campstatuscount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        app:cardCornerRadius="4dp"
        app:cardUseCompatPadding="true">

        <LinearLayout
            android:id="@+id/mainll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_patientname"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/background3"
                android:gravity="left"
                android:padding="5dp"
                android:text="Patient Name"
                android:textColor="@color/black"
                android:textSize="14sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0.4dp"
                android:background="@color/lightGray" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">




                <ImageView
                    android:id="@+id/tv_basic"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.1"
                    android:padding="5dp" />

                <TextView
                    android:id="@+id/tv_basic_na"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.1"
                    android:gravity="center"
                    android:padding="5dp"
                    android:text="NA" />

                <View
                    android:layout_width="0.4dp"
                    android:layout_height="match_parent"
                    android:background="@color/darkGray" />


                <ImageView
                    android:id="@+id/tv_PE"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.1"
                    android:padding="5dp" />

                <TextView
                    android:id="@+id/tv_PE_na"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.1"
                    android:gravity="center"
                    android:padding="5dp"
                    android:text="NA" />

                <View
                    android:layout_width="0.4dp"
                    android:layout_height="match_parent"
                    android:background="@color/darkGray" />

                <ImageView
                    android:id="@+id/tv_LFT"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.1"
                    android:gravity="center"
                    android:padding="5dp" />

                <TextView
                    android:id="@+id/tv_LFT_na"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.1"
                    android:gravity="center"
                    android:padding="5dp"
                    android:text="NA" />

                <View
                    android:layout_width="0.4dp"
                    android:layout_height="match_parent"
                    android:background="@color/darkGray" />

                <ImageView
                    android:id="@+id/tv_VST"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.1"
                    android:gravity="center"
                    android:padding="5dp" />

                <TextView
                    android:id="@+id/tv_VST_na"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.1"
                    android:gravity="center"
                    android:padding="5dp"
                    android:text="NA" />

                <View
                    android:layout_width="0.4dp"
                    android:layout_height="match_parent"
                    android:background="@color/darkGray" />

                <ImageView
                    android:id="@+id/tv_AST"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.1"
                    android:gravity="center"
                    android:padding="5dp" />

                <TextView
                    android:id="@+id/tv_AST_na"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.1"
                    android:gravity="center"
                    android:padding="5dp"
                    android:text="NA" />

                <View
                    android:layout_width="0.4dp"
                    android:layout_height="match_parent"
                    android:background="@color/darkGray" />

                <ImageView
                    android:id="@+id/tv_SC"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.1"
                    android:gravity="center"
                    android:padding="5dp" />

                <TextView
                    android:id="@+id/tv_SC_na"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.1"
                    android:gravity="center"
                    android:padding="5dp"
                    android:text="NA" />

                <View
                    android:layout_width="0.4dp"
                    android:visibility="gone"
                    android:layout_height="match_parent"
                    android:background="@color/darkGray" />

                <ImageView
                    android:id="@+id/tv_PP"
                    android:visibility="gone"

                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.1"
                    android:gravity="center"
                    android:padding="5dp" />

                <TextView
                    android:id="@+id/tv_PP_na"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.1"
                    android:visibility="gone"

                    android:gravity="center"
                    android:padding="5dp"
                    android:text="NA" />

                <View
                    android:layout_width="0.4dp"
                    android:layout_height="match_parent"
                    android:background="@color/darkGray" />

                <ImageView
                    android:id="@+id/tv_acknowlege"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.1"
                    android:visibility="gone"
                    android:gravity="center"
                    android:padding="5dp" />

                <TextView
                    android:id="@+id/tv_acknowlege_na"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.1"
                    android:visibility="gone"
                    android:gravity="center"
                    android:padding="5dp"
                    android:text="NA" />

                <View
                    android:layout_width="0.4dp"
                    android:layout_height="match_parent"
                    android:background="@color/darkGray"
                    android:visibility="visible" />

                <ImageView
                    android:id="@+id/tv_urinesample"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.1"
                    android:gravity="center"
                    android:padding="5dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_urinesample_na"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.1"
                    android:gravity="center"
                    android:visibility="gone"
                    android:padding="5dp"
                    android:text="NA" />


                <View
                    android:layout_width="0.4dp"
                    android:layout_height="match_parent"
                    android:background="@color/darkGray" />

                <ImageView
                    android:id="@+id/tv_breastscreening"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.1"
                    android:gravity="center"

                    android:padding="5dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_breastscreening_na"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.1"
                    android:gravity="center"
                    android:padding="5dp"
                    android:text="NA"

                    android:visibility="gone" />

                <View
                    android:layout_width="0.4dp"
                    android:layout_height="match_parent"

                    android:background="@color/darkGray"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/tv_antigenTest"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.1"
                    android:gravity="center"
                    android:padding="5dp"

                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_antigen_na"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.1"
                    android:gravity="center"
                    android:padding="5dp"

                    android:text="NA"
                    android:visibility="gone" />

                <View
                    android:layout_width="0.4dp"
                    android:layout_height="match_parent"

                    android:background="@color/darkGray"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/tv_rtpcr"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.1"
                    android:gravity="center"
                    android:padding="5dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_rtpcr_na"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.1"
                    android:gravity="center"
                    android:padding="5dp"

                    android:text="NA"
                    android:visibility="gone" />

            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>
