<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:layout_margin="@dimen/_10sdp"
    android:background="@drawable/borderforcard"
    android:backgroundTint="@color/white"
    android:gravity="center">

    <LinearLayout
        android:id="@+id/lLToolBarWarningPopup"
        style="@style/ToolBarStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_gravity="end"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvTitleWarningPopup"
            style="@style/LabelStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="@dimen/_8sdp"
            android:layout_weight="1"
            android:gravity="start"
            android:text="WhatsApp Number Availability"
            android:textSize="14sp"
            android:textColor="@color/white"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnCloseDialog"
            style="@style/LabelStyle"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:visibility="visible"
            app:srcCompat="@drawable/ic_cross"
            app:tint="@color/white" />



    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/lLToolBarWarningPopup"
        android:layout_marginTop="@dimen/_3sdp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="@dimen/_10sdp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:gravity="start"
            android:layout_gravity="start"
            android:orientation="vertical"
            android:padding="4dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="10dp"
                android:gravity="center"
                android:orientation="horizontal">

<!--                <ImageView-->
<!--                    android:layout_width="50dp"-->
<!--                    android:layout_height="50dp"-->
<!--                    android:layout_gravity="center_vertical"-->
<!--                    />-->

                <TextView
                    android:id="@+id/tv_message"
                    style="@style/NormalStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="खालीलपैकी whatsApp असलेला क्रमांक निवडा"
                    android:textSize="16sp"
                    android:textAllCaps="false"
                   />
            </LinearLayout>


            <RadioGroup
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="0.6"
                android:orientation="vertical"
                android:weightSum="0.6">

                <RadioButton
                    android:id="@+id/rg_register_mobile_number"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.3"
                    android:text="Yes"
                    android:textColor="@color/black"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/rg_Alternate_mobile_number"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.3"

                    android:text="No"
                    android:textColor="@color/black"
                    android:textSize="14sp" />
                <RadioButton
                    android:id="@+id/rg_whatsApp_not_available"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.3"
                    android:text="No"
                    android:textColor="@color/black"
                    android:textSize="14sp" />

            </RadioGroup>



            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">




                <Button
                    android:id="@+id/btnNo"
                    android:text="Submit"
                    android:layout_width="200dp"
                    android:layout_height="50dp"
                    android:textSize="10sp"
                    android:layout_gravity="center_vertical"
                   />


            </LinearLayout>





        </LinearLayout>

    </LinearLayout>

</RelativeLayout>