<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:layout_margin="@dimen/_10sdp"
    android:background="@drawable/borderforcard"
    android:backgroundTint="@color/lightGray"
    android:gravity="center">

    <LinearLayout
        android:id="@+id/lLToolBarWarningPopup"
        style="@style/ToolBarStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_gravity="end"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvTitleWarningPopup"
            style="@style/LabelStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="@dimen/_8sdp"
            android:layout_weight="1"
            android:gravity="start"
            android:text="Color Code Info."
            android:textColor="@color/white"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnCloseDialog"
            style="@style/LabelStyle"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:visibility="visible"
            app:srcCompat="@drawable/ic_cross"
            app:tint="@color/white" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/lLToolBarWarningPopup"
        android:layout_marginTop="@dimen/_3sdp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="@dimen/_10sdp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:gravity="start"
            android:layout_gravity="start"
            android:orientation="vertical"
            android:padding="4dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="10dp"
                android:gravity="center"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:layout_gravity="center_vertical"
                    android:src="@color/white" />

                <TextView
                    android:id="@+id/tv_green"
                    style="@style/NormalStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" Doctor Not Assigned For Physical Examination"
                    android:textSize="16sp"
                    android:textAllCaps="false"
                    android:layout_marginStart="5dp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="10dp"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:layout_gravity="center"
                    android:src="@color/light_yellow" />

                <TextView
                    android:id="@+id/tv_red"
                    style="@style/NormalStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" Doctor Assigned But Call Not Done"
                    android:textAllCaps="false"
                    android:layout_marginStart="5dp"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="10dp"
                android:gravity="center"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:layout_gravity="center"
                    android:background="@drawable/borderline_grey"
                    android:src="@color/light_green" />

                <TextView
                    style="@style/NormalStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" Call Attempted To Doctor For Physical Examination"
                    android:textSize="16sp"
                    android:layout_marginStart="5dp"
                    android:textAllCaps="false"
                    android:textStyle="bold" />

            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

</RelativeLayout>