<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/AppTheme.AppBarOverlay">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorPrimary"
            android:theme="@style/AppTheme.AppBarOverlay"
            app:layout_scrollFlags="scroll|enterAlways"
            app:popupTheme="@style/ThemeOverlay.AppCompat.Light" />

    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <com.rengwuxian.materialedittext.MaterialEditText
                android:id="@+id/edt_camp_type"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="false"
                android:drawableRight="@drawable/icon_arrowdown"
                android:focusable="false"
                android:hint="@string/camp_type"
                android:inputType="textNoSuggestions"
                android:longClickable="false"
                android:textSize="14sp"
                app:met_floatingLabel="highlight"
                app:met_textColorHint="@color/darkGray" />

            <com.rengwuxian.materialedittext.MaterialEditText
                android:id="@+id/edt_initiated_by"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="false"
                android:drawableRight="@drawable/icon_arrowdown"
                android:focusable="false"
                android:hint="@string/initiated_by"
                android:inputType="textNoSuggestions"
                android:longClickable="false"
                android:textSize="14sp"
                app:met_floatingLabel="highlight"
                app:met_textColorHint="@color/darkGray" />


            <com.rengwuxian.materialedittext.MaterialEditText
                android:id="@+id/edt_district"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="false"
                android:drawableRight="@drawable/icon_arrowdown"
                android:focusable="false"
                android:hint="@string/district"
                android:inputType="textNoSuggestions"
                android:longClickable="false"
                android:textSize="14sp"
                app:met_floatingLabel="highlight"
                app:met_textColorHint="@color/darkGray" />

            <com.rengwuxian.materialedittext.MaterialEditText
                android:id="@+id/edt_unitName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="false"
                android:focusable="false"
                android:hint="Unit Name"
                android:inputType="textNoSuggestions"
                android:longClickable="false"
                android:textSize="14sp"
                android:visibility="gone"
                app:met_floatingLabel="highlight"
                app:met_textColorHint="@color/darkGray" />

            <com.rengwuxian.materialedittext.MaterialEditText
                android:id="@+id/edt_taluka"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="false"
                android:drawableEnd="@drawable/icon_downarrowbk"
                android:focusable="false"
                android:hint="@string/taluka"
                android:inputType="textNoSuggestions"
                android:longClickable="false"
                android:textSize="14sp"
                android:visibility="visible"
                app:met_floatingLabel="highlight"
                app:met_textColorHint="@color/darkGray" />

            <com.rengwuxian.materialedittext.MaterialEditText
                android:id="@+id/edt_LandingLab"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="false"
                android:drawableEnd="@drawable/icon_downarrowbk"
                android:focusable="false"
                android:hint="@string/landing_lab"
                android:inputType="textNoSuggestions"
                android:longClickable="false"
                android:textSize="14sp"
                app:met_floatingLabel="highlight"
                app:met_textColorHint="@color/darkGray" />

            <com.rengwuxian.materialedittext.MaterialEditText
                android:id="@+id/edt_camp_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:digits="abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789 "
                android:hint="@string/camp_name"
                android:textSize="14sp"
                app:met_floatingLabel="highlight"
                app:met_textColorHint="@color/darkGray" />

            <com.rengwuxian.materialedittext.MaterialEditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:digits="abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789 "
                android:hint="@string/camp_Location"
                android:textSize="14sp"
                android:focusable="false"
                android:longClickable="false"
                app:met_floatingLabel="highlight"
                app:met_textColorHint="@color/grey" />


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:paddingLeft="5dp"
                    android:visibility="gone"
                    android:paddingRight="5dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center_horizontal|center_vertical"
                        android:src="@drawable/icon_location_red" />

                    <TextView
                        android:id="@+id/tv_current_location"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal|center_vertical"
                        android:padding="5dp"
                        android:text="Current Location"
                        android:textColor="@color/black"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:layout_gravity="center"
                    android:paddingLeft="5dp"
                    android:paddingRight="5dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center_horizontal|center_vertical"
                        android:src="@drawable/icon_location_blue" />

                    <TextView
                        android:id="@+id/tv_searchOnMap"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal|center_vertical"
                        android:padding="5dp"
                        android:text="Search On Map"
                        android:textColor="@color/black"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <CheckBox
                        android:id="@+id/Checkbox"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Enter Address Manually"
                        android:textColor="@color/primaryColor"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:visibility="visible">

                    </CheckBox>

                </LinearLayout>


            </LinearLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="gone">

                <com.rengwuxian.materialedittext.MaterialEditText
                    android:id="@+id/edt_search_location"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.7"
                    android:clickable="true"
                    android:drawablePadding="8dp"
                    android:drawableTint="@color/darkGray"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:hint="@string/camp_area"
                    android:textSize="14sp"
                    android:visibility="visible"
                    app:met_floatingLabel="highlight"
                    app:met_textColorHint="@color/darkGray" />


                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="0.3"
                    android:clickable="false"
                    android:drawableStart="@drawable/outline_add_location_24"
                    android:longClickable="false"
                    android:maxLength="120"
                    android:padding="10dp"
                    android:text="Use Current Location"
                    android:textColor="@color/black"
                    android:textSize="12sp"
                    app:met_floatingLabel="highlight" />


            </LinearLayout>


            <!--            <com.rengwuxian.materialedittext.MaterialEditText-->
            <!--                android:id="@+id/edt_search_location"-->
            <!--                android:layout_width="match_parent"-->
            <!--                android:layout_height="wrap_content"-->
            <!--                android:hint="Search Location"-->
            <!--                android:textSize="14sp"-->
            <!--                android:visibility="gone"-->
            <!--                app:met_floatingLabel="highlight" />-->


            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_location"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />


            <com.rengwuxian.materialedittext.MaterialEditText
                android:id="@+id/edt_camp_address"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:digits="abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789 "
                android:hint="@string/camp_address"
                android:maxLength="150"
                android:textSize="14sp"
                android:visibility="visible"
                app:met_floatingLabel="highlight"
                app:met_textColorHint="@color/darkGray" />


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">




                <TextView
                    android:id="@+id/click_to_map"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="false"
                    android:gravity="end"
                    android:longClickable="false"
                    android:maxLength="120"
                    android:padding="10dp"
                    android:text="View Location On Map"
                    android:textColor="@color/primaryColor"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:met_floatingLabel="highlight" />


            </LinearLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.rengwuxian.materialedittext.MaterialEditText
                    android:id="@+id/edt_camp_date"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="5dp"
                    android:layout_weight="1"
                    android:drawableRight="@drawable/icon_date"
                    android:hint="@string/camp_date"
                    android:inputType="textNoSuggestions"
                    android:focusable="false"
                    android:longClickable="false"
                    android:textSize="14sp"
                    app:met_floatingLabel="highlight"
                    app:met_textColorHint="@color/darkGray" />

                <com.rengwuxian.materialedittext.MaterialEditText
                    android:id="@+id/edt_post_camp_date"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="5dp"
                    android:layout_weight="1"
                    android:drawableRight="@drawable/icon_date"
                    android:focusable="false"
                    android:hint="@string/post_camp_date"
                    android:inputType="textNoSuggestions"
                    android:longClickable="false"
                    android:textSize="14sp"
                    app:met_floatingLabel="highlight"
                    app:met_textColorHint="@color/darkGray" />

            </LinearLayout>

            <com.rengwuxian.materialedittext.MaterialEditText
                android:id="@+id/edt_lab"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawableRight="@drawable/icon_arrowdown"
                android:focusable="false"
                android:hint="Lab"
                android:inputType="textNoSuggestions"
                android:longClickable="false"
                android:textSize="14sp"
                android:visibility="gone"
                app:met_floatingLabel="highlight"
                app:met_textColorHint="@color/darkGray" />

            <com.rengwuxian.materialedittext.MaterialEditText
                android:id="@+id/edt_hospital"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawableRight="@drawable/icon_arrowdown"
                android:focusable="false"
                android:hint="Hospital"
                android:inputType="textNoSuggestions"
                android:longClickable="false"
                android:textSize="14sp"
                android:visibility="gone"
                app:met_floatingLabel="highlight"
                app:met_textColorHint="@color/darkGray" />

            <com.rengwuxian.materialedittext.MaterialEditText
                android:id="@+id/edt_screening_tests"
                android:layout_width="386dp"
                android:layout_height="wrap_content"
                android:drawableRight="@drawable/icon_arrowdown"
                android:focusable="false"
                android:hint="@string/screening_test"
                android:inputType="textNoSuggestions"
                android:longClickable="false"
                android:textSize="14sp"
                app:met_floatingLabel="highlight"
                app:met_textColorHint="@color/darkGray" />

            <com.rengwuxian.materialedittext.MaterialEditText
                android:id="@+id/edt_lab_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:hint="Home Lab"
                android:inputType="textNoSuggestions"
                android:longClickable="false"
                android:textSize="14sp"
                app:met_floatingLabel="highlight"
                app:met_textColorHint="@color/darkGray" />

            <com.rengwuxian.materialedittext.MaterialEditText
                android:id="@+id/edt_tests_for_lab_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawableRight="@drawable/icon_arrowdown"
                android:focusable="false"
                android:hint="Select Tests for Mapping - Home Lab"
                android:inputType="textNoSuggestions"
                android:longClickable="false"
                android:textSize="14sp"
                android:visibility="gone"
                app:met_floatingLabel="highlight"
                app:met_textColorHint="@color/darkGray" />

            <com.rengwuxian.materialedittext.MaterialEditText
                android:id="@+id/edt_lab_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:hint="Hub Lab"
                android:inputType="textNoSuggestions"
                android:longClickable="false"
                android:textSize="14sp"
                app:met_floatingLabel="highlight"
                app:met_textColorHint="@color/darkGray" />


            <com.rengwuxian.materialedittext.MaterialEditText
                android:id="@+id/edt_expected_Beneficiary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/expected_beneficiary_count"
                android:inputType="number"
                android:maxLength="10"
                android:textSize="14sp"
                android:visibility="visible"
                app:met_floatingLabel="highlight"
                app:met_textColorHint="@color/darkGray" />


            <com.rengwuxian.materialedittext.MaterialEditText
                android:id="@+id/edt_tests_for_lab_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawableRight="@drawable/icon_arrowdown"
                android:focusable="false"
                android:hint="Select Tests for Mapping - Hub Lab"
                android:inputType="textNoSuggestions"
                android:longClickable="false"
                android:textSize="14sp"
                android:visibility="gone"
                app:met_floatingLabel="highlight"
                app:met_textColorHint="@color/darkGray" />

            <com.rengwuxian.materialedittext.MaterialEditText
                android:id="@+id/edt_lab_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawableRight="@drawable/icon_arrowdown"
                android:focusable="false"
                android:hint="Select RT-PCR Lab"
                android:inputType="textNoSuggestions"
                android:longClickable="false"
                android:textSize="14sp"
                android:visibility="gone"
                app:met_floatingLabel="highlight"
                app:met_textColorHint="@color/darkGray" />

            <com.rengwuxian.materialedittext.MaterialEditText
                android:id="@+id/edt_tests_for_lab_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawableRight="@drawable/icon_arrowdown"
                android:focusable="false"
                android:hint="Select Tests for Mapping - RT-PCR Lab"
                android:inputType="textNoSuggestions"
                android:longClickable="false"
                android:textSize="14sp"
                android:visibility="gone"
                app:met_floatingLabel="highlight"
                app:met_textColorHint="@color/darkGray" />

            <com.rengwuxian.materialedittext.MaterialEditText
                android:id="@+id/edt_aarogyamitra_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Aarogyamitra Name"
                android:inputType="textNoSuggestions"
                android:textSize="14sp"
                android:visibility="gone"
                app:met_floatingLabel="highlight"
                app:met_textColorHint="@color/darkGray" />

            <com.rengwuxian.materialedittext.MaterialEditText
                android:id="@+id/edt_aarogyamitra_mobile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Aarogyamitra Mobile"
                android:inputType="number"
                android:maxLength="10"
                android:textSize="14sp"
                android:visibility="gone"
                app:met_floatingLabel="highlight"
                app:met_textColorHint="@color/darkGray" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/imv_camp_approval_letter"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_gravity="center"
                    android:src="@drawable/icon_colorcamera" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:padding="5dp"
                    android:text="Camp Approval Letter"
                    android:textColor="@color/black"
                    android:textSize="16sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/_40sdp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_save"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/button_gradent"
                    android:text="save"
                    android:textColor="@color/white"
                    android:textSize="18sp" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>