<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activities.SetPostCampTarget_Activity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:theme="@style/AppTheme.AppBarOverlay"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorPrimary"
            android:theme="@style/AppTheme.AppBarOverlay"
            app:layout_scrollFlags="scroll|enterAlways"
            app:popupTheme="@style/ThemeOverlay.AppCompat.Light" />

    </com.google.android.material.appbar.AppBarLayout>

    <com.rengwuxian.materialedittext.MaterialEditText
        android:id="@+id/edt_select_district"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:drawableRight="@drawable/icon_downarrowbk"
        android:focusable="false"
        android:hint="Select District"
        android:longClickable="false"
        android:textColor="@color/black"
        android:textSize="16sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/appBarLayout"
        app:met_floatingLabel="highlight"
        app:met_textColorHint="@color/darkGray" />

    <com.rengwuxian.materialedittext.MaterialEditText
        android:id="@+id/edtSelCampType"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:drawableRight="@drawable/icon_downarrowbk"
        android:focusable="false"
        android:hint="Select Camp Type"
        android:longClickable="false"
        android:textColor="@color/black"
        android:textSize="16sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/appBarLayout"
        app:met_floatingLabel="highlight"
        app:met_textColorHint="@color/darkGray" />

    <com.rengwuxian.materialedittext.MaterialEditText
        android:id="@+id/edt_from_date"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:drawableRight="@drawable/icon_calendar"
        android:focusable="false"
        android:hint="Select Date"
        android:longClickable="false"
        android:textColor="@color/black"
        android:textSize="16sp"
        android:visibility="visible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/edtSelCampType"
        app:met_floatingLabel="highlight"
        app:met_textColorHint="@color/darkGray" />

    <com.rengwuxian.materialedittext.MaterialEditText
        android:id="@+id/edt_to_date"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="2.5dp"
        android:layout_marginRight="10dp"
        android:drawableRight="@drawable/icon_calendar"
        android:focusable="false"
        android:hint="Select To Date"
        android:longClickable="false"
        android:textColor="@color/black"
        android:textSize="16sp"
        android:visibility="gone"
        app:layout_constraintLeft_toRightOf="@id/edt_from_date"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/edt_select_district"
        app:met_floatingLabel="highlight"
        app:met_textColorHint="@color/darkGray" />

    <com.rengwuxian.materialedittext.MaterialEditText
        android:id="@+id/edt_year_month"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:drawableRight="@drawable/icon_arrowdown"
        android:focusable="false"
        android:hint="Select Year and Month"
        android:longClickable="false"
        android:textColor="@color/black"
        android:textSize="16sp"
        android:visibility="gone"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/edt_select_district"
        app:met_floatingLabel="highlight"
        app:met_textColorHint="@color/darkGray" />

    <com.rengwuxian.materialedittext.MaterialEditText
        android:id="@+id/edt_target"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:hint="Set Camp Target"
        android:inputType="number"
        android:textColor="@color/black"
        android:textSize="16sp"
        android:visibility="gone"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/edt_year_month"
        app:met_floatingLabel="highlight"
        app:met_textColorHint="@color/darkGray" />

    <Button
        android:id="@+id/btn_submit"
        style="@style/Widget.AppCompat.Button.Colored"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Search"
        android:visibility="gone"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/edt_from_date" />


    <Button
        android:id="@+id/btnExport"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Export To Excel"
        android:textAllCaps="false"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/llSwitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/edt_from_date">

        <RadioGroup
            android:id="@+id/rgSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbDistrict"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="District Wise" />

            <RadioButton
                android:id="@+id/rbDivision"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Division Wise" />

        </RadioGroup>

        <TextView
            android:id="@+id/textView4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="District Wise"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@+id/switchCompat"
            app:layout_constraintStart_toEndOf="@+id/switchCompat"
            app:layout_constraintTop_toTopOf="@+id/switchCompat" />

    </androidx.appcompat.widget.LinearLayoutCompat>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/llHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@color/colorPrimary"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@+id/llSwitch">

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="@color/mediumGray" />

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content">


            <TextView
                android:id="@+id/distName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_weight="1.5"
                android:gravity="center"
                android:padding="2dp"
                android:text="Dist Name"
                android:textColor="@color/white"
                android:textSize="12sp" />

            <TextView
                style="?android:attr/listSeparatorTextViewStyle"
                android:layout_width="0.5dp"
                android:layout_height="match_parent"
                android:background="@color/mediumGray"
                android:gravity="center_vertical" />


            <TextView
                android:id="@+id/targetToAchieve"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_weight="1"
                android:gravity="center"
                android:padding="2dp"
                android:text="Monthly Target To Achieve"
                android:textColor="@color/white"
                android:textSize="12sp"

                />

            <TextView
                style="?android:attr/listSeparatorTextViewStyle"
                android:layout_width="0.5dp"
                android:layout_height="match_parent"
                android:background="@color/mediumGray"
                android:gravity="center_vertical" />

            <TextView
                android:id="@+id/targetAchieved"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_weight="1"
                android:gravity="center"
                android:padding="2dp"
                android:text="Monthly Target \nAchieved"
                android:textColor="@color/white"
                android:textSize="12sp"

                />


            <TextView
                style="?android:attr/listSeparatorTextViewStyle"
                android:layout_width="0.5dp"
                android:layout_height="match_parent"
                android:background="@color/mediumGray"
                android:gravity="center_vertical" />


            <TextView
                android:id="@+id/perDayTarget"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:layout_weight="1"
                android:gravity="center"
                android:padding="2dp"
                android:background="@color/colorPrimaryDark"
                android:text="Daily Target"
                android:textColor="@color/white"
                android:textSize="12sp"

                />


            <TextView
                style="?android:attr/listSeparatorTextViewStyle"
                android:layout_width="0.5dp"
                android:layout_height="match_parent"
                android:background="@color/mediumGray"
                android:gravity="center_vertical" />

            <TextView
                android:id="@+id/targetRemain"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:layout_weight="1"
                android:gravity="center"
                android:background="@color/colorPrimaryDark"
                android:padding="2dp"
                android:text="Daily Target \nAchieved"
                android:textColor="@color/white"
                android:textSize="12sp"

                />

        </androidx.appcompat.widget.LinearLayoutCompat>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/mediumGray" />

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/llTotal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/llHeader">


            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:orientation="horizontal">


                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_weight="1.5"
                    android:padding="2dp"
                    android:text="Total"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    style="?android:attr/listSeparatorTextViewStyle"
                    android:layout_width="0.5dp"
                    android:layout_height="match_parent"
                    android:background="@color/mediumGray"
                    android:gravity="center_vertical" />

                <TextView
                    android:id="@+id/tvTotalMonthlyTarget"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:padding="2dp"
                    android:text="00000"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    android:textStyle="bold"

                    />

                <TextView
                    style="?android:attr/listSeparatorTextViewStyle"
                    android:layout_width="0.5dp"
                    android:layout_height="match_parent"
                    android:background="@color/mediumGray"
                    android:gravity="center_vertical" />

                <TextView
                    android:id="@+id/tvTotalMonthlyTargetAchieved"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:padding="2dp"
                    android:text="00000"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    android:textStyle="bold"

                    />

                <TextView
                    style="?android:attr/listSeparatorTextViewStyle"
                    android:layout_width="0.5dp"
                    android:layout_height="match_parent"
                    android:background="@color/mediumGray"
                    android:gravity="center_vertical" />


                <TextView
                    android:id="@+id/tvTotalDailyTarget"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:padding="2dp"
                    android:text="00000"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    android:textStyle="bold"

                    />


                <TextView
                    style="?android:attr/listSeparatorTextViewStyle"
                    android:layout_width="0.5dp"
                    android:layout_height="match_parent"
                    android:background="@color/mediumGray"
                    android:gravity="center_vertical" />

                <TextView
                    android:id="@+id/tvTotalDailyTargetAchieved"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:padding="2dp"
                    android:text="00000"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    android:textStyle="bold"

                    />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/mediumGray" />

        </androidx.appcompat.widget.LinearLayoutCompat>


    </androidx.appcompat.widget.LinearLayoutCompat>


    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvTargetList"

        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/llHeader" />

</androidx.constraintlayout.widget.ConstraintLayout>