<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/AppTheme.AppBarOverlay">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorPrimary"
            android:theme="@style/AppTheme.AppBarOverlay"
            app:layout_scrollFlags="scroll|enterAlways"
            app:popupTheme="@style/ThemeOverlay.AppCompat.Light" />

    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.cardview.widget.CardView xmlns:card_view="http://schemas.android.com/apk/res-auto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                card_view:cardBackgroundColor="@android:color/white"
                card_view:cardElevation="2dp"
                card_view:cardUseCompatPadding="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/gradent_lighttodark"
                        android:padding="5dp"
                        android:text="Patient Details"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <com.rengwuxian.materialedittext.MaterialEditText
                        android:id="@+id/edt_beneficiaryname"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="5dp"
                        android:layout_marginRight="5dp"
                        android:clickable="false"
                        android:focusable="false"
                        android:hint="Name of the Beneficiary"
                        android:longClickable="false"
                        android:textSize="16sp"
                        app:met_floatingLabel="highlight"
                        app:met_textColorHint="@color/darkGray"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="5dp"
                        android:layout_marginRight="5dp"
                        android:orientation="horizontal"
                        android:weightSum="1">

                        <com.rengwuxian.materialedittext.MaterialEditText
                            android:id="@+id/edt_gender"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="3dp"
                            android:layout_weight="0.5"
                            android:clickable="false"
                            android:focusable="false"
                            android:hint="Gender"
                            android:longClickable="false"
                            android:textSize="16sp"
                            app:met_floatingLabel="highlight"
                            app:met_textColorHint="@color/darkGray" />

                        <com.rengwuxian.materialedittext.MaterialEditText
                            android:id="@+id/edt_age"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="3dp"
                            android:layout_weight="0.5"
                            android:clickable="false"
                            android:focusable="false"
                            android:hint="Age"
                            android:inputType="number"
                            android:longClickable="false"
                            android:maxLength="3"
                            android:textSize="16sp"
                            app:met_floatingLabel="highlight"
                            app:met_textColorHint="@color/darkGray" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="5dp"
                        android:layout_marginRight="5dp"
                        android:visibility="gone"
                        android:orientation="horizontal"
                        android:weightSum="1">

                        <com.rengwuxian.materialedittext.MaterialEditText
                            android:id="@+id/edt_height"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="3dp"
                            android:layout_weight="0.5"
                            android:clickable="false"
                            android:focusable="false"
                            android:hint="Height"
                            android:longClickable="false"
                            android:textSize="16sp"
                            app:met_floatingLabel="highlight"
                            app:met_textColorHint="@color/darkGray" />

                        <com.rengwuxian.materialedittext.MaterialEditText
                            android:id="@+id/edt_weight"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="3dp"
                            android:layout_weight="0.5"
                            android:clickable="false"
                            android:focusable="false"
                            android:hint="Weight"
                            android:longClickable="false"
                            android:textSize="16sp"
                            app:met_floatingLabel="highlight"
                            app:met_textColorHint="@color/darkGray" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <RadioGroup
                android:id="@+id/rgTestType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:background="@color/lightGray"
                android:layout_margin="5dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbSnellenChart"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Snellen Chart" />

                <RadioButton
                    android:id="@+id/rbMachine"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Machine" />
            </RadioGroup>

            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/llMain"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    card_view:cardBackgroundColor="@android:color/white"
                    card_view:cardElevation="2dp"
                    card_view:cardUseCompatPadding="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">



                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/gradent_lighttodark"
                            android:padding="5dp"
                            android:text="Visually Impaired (Blindness)"
                            android:textColor="@color/white"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="5dp"
                            android:layout_marginRight="5dp"
                            android:orientation="horizontal">

                            <com.rengwuxian.materialedittext.MaterialEditText
                                android:id="@+id/edt_blindness"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginRight="3dp"
                                android:layout_weight="0.3"
                                android:drawableRight="@drawable/icon_arrowdown"
                                android:focusable="false"
                                android:hint="Select Visually Impaired"
                                android:textSize="16sp"
                                app:met_floatingLabel="highlight"
                                app:met_textColorHint="@color/darkGray" />

                        </LinearLayout>



                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/gradent_lighttodark"
                            android:padding="5dp"
                            android:text="Evidence of Disease or injury"
                            android:textColor="@color/white"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:id="@+id/ll_vst"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="5dp"
                                android:layout_marginRight="5dp"
                                android:orientation="horizontal"
                                android:visibility="gone">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginRight="3dp"
                                    android:layout_weight="0.5"
                                    android:text="For Distance:"
                                    android:textColor="@color/black"
                                    android:textSize="18sp"
                                    app:met_floatingLabel="highlight"
                                    app:met_textColorHint="@color/darkGray" />

                                <CheckBox
                                    android:id="@+id/cb_right"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginLeft="3dp"
                                    android:layout_weight="0.5"
                                    android:text="Right"
                                    android:textSize="16sp"
                                    app:met_floatingLabel="highlight"
                                    app:met_textColorHint="@color/darkGray" />

                                <CheckBox
                                    android:id="@+id/cb_left"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginLeft="3dp"
                                    android:layout_weight="0.5"
                                    android:text="Left"
                                    android:textSize="16sp"
                                    app:met_floatingLabel="highlight"
                                    app:met_textColorHint="@color/darkGray" />

                                <CheckBox
                                    android:id="@+id/cb_both"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginLeft="3dp"
                                    android:layout_weight="0.5"
                                    android:text="Both"
                                    android:textSize="16sp"
                                    app:met_floatingLabel="highlight"
                                    app:met_textColorHint="@color/darkGray" />

                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="5dp"
                                android:layout_marginRight="5dp"
                                android:orientation="horizontal">


                                <com.rengwuxian.materialedittext.MaterialEditText
                                    android:id="@+id/edt_injury_left"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginRight="3dp"
                                    android:layout_weight="0.3"
                                    android:drawableRight="@drawable/icon_arrowdown"
                                    android:focusable="false"
                                    android:hint="Left"
                                    android:textSize="16sp"
                                    app:met_floatingLabel="highlight"
                                    app:met_textColorHint="@color/darkGray" />

                                <com.rengwuxian.materialedittext.MaterialEditText
                                    android:id="@+id/edt_injury_right"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginRight="3dp"
                                    android:layout_weight="0.3"
                                    android:drawableRight="@drawable/icon_arrowdown"
                                    android:focusable="false"
                                    android:hint="Right"
                                    android:textSize="16sp"
                                    app:met_floatingLabel="highlight"
                                    app:met_textColorHint="@color/darkGray" />


                            </LinearLayout>

                            <androidx.cardview.widget.CardView xmlns:card_view="http://schemas.android.com/apk/res-auto"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                card_view:cardBackgroundColor="@android:color/white"
                                card_view:cardElevation="2dp"
                                card_view:cardUseCompatPadding="true">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:background="@drawable/gradent_lighttodark"
                                        android:padding="5dp"
                                        android:text="Snellen Chart"
                                        android:textColor="@color/white"
                                        android:textSize="18sp"
                                        android:textStyle="bold" />

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginLeft="5dp"
                                        android:layout_marginRight="5dp"
                                        android:orientation="horizontal">


                                        <com.rengwuxian.materialedittext.MaterialEditText
                                            android:id="@+id/edt_snellen_left"
                                            android:layout_width="0dp"
                                            android:layout_height="wrap_content"
                                            android:layout_marginRight="3dp"
                                            android:layout_weight="0.3"
                                            android:drawableRight="@drawable/icon_arrowdown"
                                            android:focusable="false"
                                            android:hint="Left"
                                            android:textSize="16sp"
                                            app:met_floatingLabel="highlight"
                                            app:met_textColorHint="@color/darkGray" />

                                        <com.rengwuxian.materialedittext.MaterialEditText
                                            android:id="@+id/edt_snellen_right"
                                            android:layout_width="0dp"
                                            android:layout_height="wrap_content"
                                            android:layout_marginRight="3dp"
                                            android:layout_weight="0.3"
                                            android:drawableRight="@drawable/icon_arrowdown"
                                            android:focusable="false"
                                            android:hint="Right"
                                            android:textSize="16sp"
                                            app:met_floatingLabel="highlight"
                                            app:met_textColorHint="@color/darkGray" />


                                    </LinearLayout>

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginLeft="5dp"
                                        android:layout_marginTop="2dp"
                                        android:layout_marginRight="5dp"
                                        android:orientation="horizontal">


                                        <com.rengwuxian.materialedittext.MaterialEditText
                                            android:id="@+id/edt_leftSnellen_remark"
                                            android:layout_width="0dp"
                                            android:layout_height="wrap_content"
                                            android:layout_marginRight="3dp"
                                            android:layout_weight="0.5"
                                            android:focusable="false"
                                            android:hint="Left Eye Remark"
                                            android:textSize="16sp"
                                            app:met_floatingLabel="highlight"
                                            app:met_textColorHint="@color/darkGray" />

                                        <com.rengwuxian.materialedittext.MaterialEditText
                                            android:id="@+id/edt_rightSnellen_remark"
                                            android:layout_width="0dp"
                                            android:layout_height="wrap_content"
                                            android:layout_marginLeft="3dp"
                                            android:layout_weight="0.5"
                                            android:focusable="false"
                                            android:hint="Right Eye Remark"
                                            android:textSize="16sp"
                                            app:met_floatingLabel="highlight"
                                            app:met_textColorHint="@color/darkGray" />


                                    </LinearLayout>


                                </LinearLayout>
                            </androidx.cardview.widget.CardView>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="5dp"
                                android:layout_marginRight="5dp"
                                android:orientation="horizontal"
                                android:visibility="gone">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:layout_marginRight="3dp"
                                    android:layout_weight="0.2"
                                    android:gravity="center_vertical"
                                    android:text="Eye Color:"
                                    android:textColor="@color/black"
                                    android:textSize="18sp"
                                    app:met_floatingLabel="highlight"
                                    app:met_textColorHint="@color/darkGray" />

                                <com.rengwuxian.materialedittext.MaterialEditText
                                    android:id="@+id/edt_eyecolor_right"

                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginRight="3dp"
                                    android:layout_weight="0.3"
                                    android:drawableRight="@drawable/icon_arrowdown"
                                    android:focusable="false"
                                    android:hint="Right"
                                    android:textSize="16sp"
                                    app:met_floatingLabel="highlight"
                                    app:met_textColorHint="@color/darkGray" />

                                <com.rengwuxian.materialedittext.MaterialEditText
                                    android:id="@+id/edt_eyecolor_left"

                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginRight="3dp"
                                    android:layout_weight="0.3"
                                    android:drawableRight="@drawable/icon_arrowdown"
                                    android:focusable="false"
                                    android:hint="Left"
                                    android:textSize="16sp"
                                    app:met_floatingLabel="highlight"
                                    app:met_textColorHint="@color/darkGray" />

                            </LinearLayout>


                            <androidx.cardview.widget.CardView xmlns:card_view="http://schemas.android.com/apk/res-auto"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                card_view:cardBackgroundColor="@android:color/white"
                                card_view:cardElevation="2dp"
                                card_view:cardUseCompatPadding="true">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:background="@drawable/gradent_lighttodark"
                                        android:padding="5dp"
                                        android:text="Near Vision Chart"
                                        android:textColor="@color/white"
                                        android:textSize="18sp"
                                        android:textStyle="bold" />


                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginLeft="5dp"
                                        android:layout_marginRight="5dp"
                                        android:orientation="horizontal">


                                        <com.rengwuxian.materialedittext.MaterialEditText
                                            android:id="@+id/edt_jaegar_chart_left"
                                            android:layout_width="0dp"
                                            android:layout_height="wrap_content"
                                            android:layout_marginRight="3dp"
                                            android:layout_weight="0.3"
                                            android:drawableRight="@drawable/icon_arrowdown"
                                            android:focusable="false"
                                            android:hint="Left"
                                            android:textSize="16sp"
                                            app:met_floatingLabel="highlight"
                                            app:met_textColorHint="@color/darkGray" />

                                        <com.rengwuxian.materialedittext.MaterialEditText
                                            android:id="@+id/edt_jaegar_chart_right"
                                            android:layout_width="0dp"
                                            android:layout_height="wrap_content"
                                            android:layout_marginRight="3dp"
                                            android:layout_weight="0.3"
                                            android:drawableRight="@drawable/icon_arrowdown"
                                            android:focusable="false"
                                            android:hint="Right"
                                            android:textSize="16sp"
                                            app:met_floatingLabel="highlight"
                                            app:met_textColorHint="@color/darkGray" />


                                    </LinearLayout>
                                </LinearLayout>
                            </androidx.cardview.widget.CardView>

                            <androidx.cardview.widget.CardView xmlns:card_view="http://schemas.android.com/apk/res-auto"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:visibility="gone"
                                card_view:cardBackgroundColor="@android:color/white"
                                card_view:cardElevation="2dp"
                                card_view:cardUseCompatPadding="true">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:background="@drawable/gradent_lighttodark"
                                        android:padding="5dp"
                                        android:text="Color Vision Test"
                                        android:textColor="@color/white"
                                        android:textSize="18sp"
                                        android:textStyle="bold" />

                                    <include layout="@layout/layout_vision_plate" />

                                </LinearLayout>
                            </androidx.cardview.widget.CardView>


                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="5dp"
                                android:layout_marginTop="2dp"
                                android:layout_marginRight="5dp"
                                android:orientation="horizontal">


                                <com.rengwuxian.materialedittext.MaterialEditText
                                    android:id="@+id/edt_left_remark"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginRight="3dp"
                                    android:layout_weight="0.5"
                                    android:focusable="false"
                                    android:hint="Left Eye Remark"
                                    android:textSize="16sp"
                                    app:met_floatingLabel="highlight"
                                    app:met_textColorHint="@color/darkGray" />

                                <com.rengwuxian.materialedittext.MaterialEditText
                                    android:id="@+id/edt_right_remark"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginLeft="3dp"
                                    android:layout_weight="0.5"
                                    android:focusable="false"
                                    android:hint="Right Eye Remark"
                                    android:textSize="16sp"
                                    app:met_floatingLabel="highlight"
                                    app:met_textColorHint="@color/darkGray" />

                            </LinearLayout>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@drawable/gradent_lighttodark"
                                android:padding="5dp"
                                android:text="Wearing Spectacle ?"
                                android:textColor="@color/white"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:background="@drawable/bg_outline"
                                android:orientation="horizontal"
                                android:padding="5dp">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:layout_weight="0.6"
                                    android:gravity="center_vertical"
                                    android:text="Wearing spectacle ?"
                                    android:textColor="@color/black"
                                    android:textSize="16sp" />

                                <RadioGroup
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="0.4"
                                    android:orientation="horizontal"
                                    android:weightSum="0.6">

                                    <RadioButton
                                        android:id="@+id/rb_glasses_yes"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="0.3"
                                        android:checked="true"
                                        android:text="Yes"
                                        android:textColor="@color/black"
                                        android:textSize="16sp" />

                                    <RadioButton
                                        android:id="@+id/rb_glasses_no"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="0.3"
                                        android:text="No"
                                        android:textColor="@color/black"
                                        android:textSize="16sp" />


                                </RadioGroup>

                            </LinearLayout>



                            <com.rengwuxian.materialedittext.MaterialEditText
                                android:id="@+id/edt_near_remark"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="5dp"
                                android:layout_marginTop="2dp"
                                android:visibility="gone"
                                android:layout_marginRight="5dp"
                                android:drawableRight="@drawable/icon_arrowdown"
                                android:focusable="false"
                                android:hint="Near Vision Remark"
                                android:textSize="16sp"
                                app:met_floatingLabel="highlight"
                                app:met_textColorHint="@color/darkGray" />


                            <com.rengwuxian.materialedittext.MaterialEditText
                                android:id="@+id/edt_remark"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="5dp"
                                android:layout_marginRight="5dp"
                                android:hint="Other Remark"
                                android:textSize="16sp"
                                android:visibility="gone"
                                app:met_floatingLabel="highlight"
                                app:met_textColorHint="@color/darkGray" />

                            <Button
                                android:id="@+id/btn_register"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:background="@drawable/button_gradent"
                                android:padding="10dp"
                                android:layout_marginBottom="@dimen/_40sdp"
                                android:text="SUBMIT"
                                android:textColor="@color/white"
                                android:textSize="20sp" />

                        </LinearLayout>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>
            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/llMachine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:layout_marginTop="20dp"
                android:orientation="vertical"
                android:visibility="gone">


                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/llChart"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">


                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:weightSum="3">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_margin="2dp"
                            android:layout_weight="0.4"
                            android:padding="5dp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_margin="2dp"
                            android:layout_weight="1.2"
                            android:padding="5dp"
                            android:text="Right"
                            android:textAlignment="center" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_margin="2dp"
                            android:layout_weight="1.2"
                            android:padding="5dp"
                            android:text="Left"
                            android:textAlignment="center" />
                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:weightSum="3">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_margin="2dp"
                            android:background="@drawable/chart_top_left_corner"
                            android:padding="5dp"
                            android:text="S"
                            android:textColor="@color/white"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvSRight"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_margin="2dp"
                            android:layout_weight="1.2"
                            android:background="@color/light_green_blue"
                            android:padding="5dp"
                            android:text="0"
                            android:textAlignment="center"
                            android:textColor="@color/white" />

                        <TextView
                            android:id="@+id/tvSLeft"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_margin="2dp"
                            android:layout_weight="1.2"
                            android:background="@drawable/chart_top_right_corner"
                            android:padding="5dp"
                            android:text="0"
                            android:textAlignment="center"
                            android:textColor="@color/white" />
                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:weightSum="3">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_margin="2dp"
                            android:background="@color/dark_green"
                            android:padding="5dp"
                            android:text="C"
                            android:textColor="@color/white"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvCRight"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_margin="2dp"
                            android:layout_weight="1.2"
                            android:background="@color/light_green_blue"
                            android:padding="5dp"
                            android:text="0"
                            android:textAlignment="center"
                            android:textColor="@color/white" />

                        <TextView
                            android:id="@+id/tvCLeft"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_margin="2dp"
                            android:layout_weight="1.2"
                            android:background="@color/light_green_blue"
                            android:padding="5dp"
                            android:text="0"
                            android:textAlignment="center"
                            android:textColor="@color/white" />
                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:weightSum="3">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_margin="2dp"
                            android:background="@drawable/chart_bottom_left_corner_green"
                            android:padding="5dp"
                            android:text="A"
                            android:textColor="@color/white"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvARight"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_margin="2dp"
                            android:layout_weight="1.2"
                            android:background="@color/light_green_blue"
                            android:padding="5dp"
                            android:text="0"
                            android:textAlignment="center"
                            android:textColor="@color/white" />

                        <TextView
                            android:id="@+id/tvALeft"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_margin="2dp"
                            android:layout_weight="1.2"
                            android:background="@drawable/chart_bottom_right_corner"
                            android:padding="5dp"
                            android:text="0"
                            android:textAlignment="center"
                            android:textColor="@color/white" />
                    </androidx.appcompat.widget.LinearLayoutCompat>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawableEnd="@drawable/ic_baseline_replay_24"
                        android:text="Re-scan"
                        android:textAlignment="center"
                        android:gravity="center"
                        android:id="@+id/tvRescan"
                        android:visibility="visible"
                        android:layout_gravity="center"
                        android:padding="5dp"
                        android:layout_marginTop="10dp"
                        android:textColor="@color/grey"
                        />

                </androidx.appcompat.widget.LinearLayoutCompat>

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/llScanner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageButton
                        android:id="@+id/btnScanQRCOde"
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:layout_gravity="center"
                        android:layout_marginTop="20dp"
                        android:background="@color/white"
                        android:scaleType="fitXY"
                        android:src="@drawable/ic_qrcode" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Scan QR Code displayed on machine"
                        android:textColor="@color/grey"
                        android:textSize="12sp" />
                </androidx.appcompat.widget.LinearLayoutCompat>




                <Button
                    android:id="@+id/btnSubmitMachineData"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/_40sdp"
                    android:text="Submit"
                    android:visibility="gone"
                    android:textAllCaps="false" />



            </androidx.appcompat.widget.LinearLayoutCompat>
        </LinearLayout>

    </ScrollView>

</LinearLayout>