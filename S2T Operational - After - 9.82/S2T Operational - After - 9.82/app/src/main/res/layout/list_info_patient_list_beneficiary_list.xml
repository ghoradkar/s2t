<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cv_title"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    card_view:cardBackgroundColor="@android:color/darker_gray"
    card_view:cardElevation="2dp"
    card_view:cardUseCompatPadding="true">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="5dp">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="1">


            <View
                android:layout_width="0.5dp"
                android:layout_height="match_parent"
                android:background="@color/mediumGray" />

            <ImageButton
                android:id="@+id/tv_patientname"
                android:layout_width="0dp"
                android:layout_height="35dp"
                android:layout_weight="0.1"
                android:background="@color/white"
                android:paddingLeft="5dp"
                android:textSize="14sp" />

            <View
                android:layout_width="0.5dp"
                android:layout_height="match_parent"
                android:background="@color/mediumGray" />

            <TextView
                android:id="@+id/tv_type"
                android:layout_width="0dp"
                android:layout_height="35dp"
                android:layout_weight="0.9"
                android:gravity="center_vertical"
                android:paddingLeft="5dp"
                android:text="Benifeciary approval or rejection is pending "
                android:textColor="@color/black"
                android:textSize="14sp" />


            <!--        <ImageView-->
            <!--            android:layout_width="20dp"-->
            <!--            android:layout_height="20dp"-->
            <!--            android:visibility="gone"-->
            <!--            android:id="@+id/imvCall"-->
            <!--            android:src="@android:drawable/sym_call_outgoing"-->
            <!--            android:padding="5dp"/>-->

        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal"
            android:weightSum="1">


            <View
                android:layout_width="0.5dp"
                android:layout_height="match_parent"
                android:background="@color/mediumGray" />

            <ImageButton
                android:id="@+id/tv_patientname1"
                android:layout_width="0dp"
                android:layout_height="35dp"
                android:layout_weight="0.1"
                android:background="@color/light_green"
                android:paddingLeft="5dp"
                android:textSize="14sp" />

            <View
                android:layout_width="0.5dp"
                android:layout_height="match_parent"
                android:background="@color/mediumGray" />

            <TextView
                android:id="@+id/tv_type1"
                android:layout_width="0dp"
                android:layout_height="35dp"
                android:layout_weight="0.9"
                android:gravity="center_vertical"
                android:paddingLeft="5dp"
                android:text="Approved Beneficiary"
                android:textColor="@color/black"
                android:textSize="14sp" />


            <!--        <ImageView-->
            <!--            android:layout_width="20dp"-->
            <!--            android:layout_height="20dp"-->
            <!--            android:visibility="gone"-->
            <!--            android:id="@+id/imvCall"-->
            <!--            android:src="@android:drawable/sym_call_outgoing"-->
            <!--            android:padding="5dp"/>-->

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal"
            android:weightSum="1">


            <View
                android:layout_width="0.5dp"
                android:layout_height="match_parent"
                android:background="@color/mediumGray" />

            <ImageButton
                android:id="@+id/tv_patientname2"
                android:layout_width="0dp"
                android:layout_height="35dp"
                android:layout_weight="0.1"
                android:background="@color/redLight"
                android:paddingLeft="5dp"
                android:textSize="14sp" />

            <View
                android:layout_width="0.5dp"
                android:layout_height="match_parent"
                android:background="@color/mediumGray" />

            <TextView
                android:id="@+id/tv_type2"
                android:layout_width="0dp"
                android:layout_height="35dp"
                android:layout_weight="0.9"
                android:gravity="center_vertical"
                android:paddingLeft="5dp"
                android:text="Rejected Beneficiary"
                android:textColor="@color/black"
                android:textSize="14sp" />


            <!--        <ImageView-->
            <!--            android:layout_width="20dp"-->
            <!--            android:layout_height="20dp"-->
            <!--            android:visibility="gone"-->
            <!--            android:id="@+id/imvCall"-->
            <!--            android:src="@android:drawable/sym_call_outgoing"-->
            <!--            android:padding="5dp"/>-->

        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal"
            android:visibility="visible"
            android:weightSum="1">


            <View
                android:layout_width="0.5dp"
                android:layout_height="match_parent"
                android:background="@color/mediumGray" />

            <ImageButton
                android:layout_width="0dp"
                android:layout_height="35dp"
                android:layout_weight="0.1"
                android:background="@color/light_blue"
                android:paddingLeft="5dp"
                android:textSize="14sp" />

            <View
                android:layout_width="0.5dp"
                android:layout_height="match_parent"
                android:background="@color/mediumGray" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="35dp"
                android:layout_weight="0.9"
                android:gravity="center_vertical"
                android:paddingLeft="5dp"
                android:text="Re-Verification Required"
                android:textColor="@color/black"
                android:textSize="14sp" />


            <!--        <ImageView-->
            <!--            android:layout_width="20dp"-->
            <!--            android:layout_height="20dp"-->
            <!--            android:visibility="gone"-->
            <!--            android:id="@+id/imvCall"-->
            <!--            android:src="@android:drawable/sym_call_outgoing"-->
            <!--            android:padding="5dp"/>-->

        </LinearLayout>

    </LinearLayout>


</androidx.cardview.widget.CardView>