<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@android:color/white"
        app:cardElevation="2dp"
        app:cardUseCompatPadding="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_bloodsample"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/gradent_lighttodark"
                android:drawablePadding="10dp"
                android:padding="5dp"
                android:text="Lung Function Test"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:id="@+id/txtLicense"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnScan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_margin="10dp"
                    android:background="@drawable/button_gradent"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:text="Scan for Spirometer Devices"
                    android:textColor="@color/white" />

                <Button
                    android:id="@+id/btnConnectSpiro"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_margin="10dp"
                    android:background="@drawable/button_gradent"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:textColor="@color/white"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btnSpiro"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_margin="10dp"
                    android:background="@drawable/button_gradent"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:text="Start Spirometer"
                    android:textColor="@color/white"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/txtSpiroId"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtSpiro"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <androidx.cardview.widget.CardView
                    android:id="@+id/cv_siprostatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:visibility="gone"
                    app:cardCornerRadius="4dp"
                    app:cardUseCompatPadding="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/gradent_lighttodark"
                            android:gravity="center"
                            android:padding="5dp"
                            android:text="Spirometer Status"
                            android:textColor="@color/white"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingLeft="5dp"
                            android:paddingRight="5dp"
                            android:paddingBottom="5dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:layout_weight="0.5"
                                    android:clickable="false"
                                    android:gravity="center"
                                    android:inputType="textMultiLine|textNoSuggestions"
                                    android:longClickable="false"
                                    android:padding="5dp"
                                    android:text="FVC"
                                    android:textColor="@color/black"
                                    android:textSize="14sp" />

                                <View
                                    android:layout_width="0.5dp"
                                    android:layout_height="match_parent"
                                    android:background="@color/lightGray" />

                                <TextView
                                    android:id="@+id/tv_fcv"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="0.5"
                                    android:clickable="false"
                                    android:gravity="center"
                                    android:inputType="textMultiLine|textNoSuggestions"
                                    android:longClickable="false"
                                    android:padding="5dp"
                                    android:textColor="@color/black"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />

                            </LinearLayout>

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="0.5dp"
                                android:background="@color/lightGray" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:layout_weight="0.5"
                                    android:clickable="false"
                                    android:gravity="center"
                                    android:inputType="textMultiLine|textNoSuggestions"
                                    android:longClickable="false"
                                    android:padding="5dp"
                                    android:text="FEV1"
                                    android:textColor="@color/black"
                                    android:textSize="14sp" />

                                <View
                                    android:layout_width="0.5dp"
                                    android:layout_height="match_parent"
                                    android:background="@color/lightGray" />

                                <TextView
                                    android:id="@+id/tv_fev1"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="0.5"
                                    android:clickable="false"
                                    android:gravity="center"
                                    android:inputType="textMultiLine|textNoSuggestions"
                                    android:longClickable="false"
                                    android:padding="5dp"
                                    android:textColor="@color/black"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />

                            </LinearLayout>

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="0.5dp"
                                android:background="@color/lightGray" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:layout_weight="0.5"
                                    android:clickable="false"
                                    android:gravity="center"
                                    android:inputType="textMultiLine|textNoSuggestions"
                                    android:longClickable="false"
                                    android:padding="5dp"
                                    android:text=" FEVI / FVC"
                                    android:textColor="@color/black"
                                    android:textSize="14sp" />

                                <View
                                    android:layout_width="0.5dp"
                                    android:layout_height="match_parent"
                                    android:background="@color/lightGray" />

                                <TextView
                                    android:id="@+id/tv_fev1_fcv_ratio"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="0.5"
                                    android:clickable="false"
                                    android:gravity="center"
                                    android:inputType="textMultiLine|textNoSuggestions"
                                    android:longClickable="false"
                                    android:padding="5dp"
                                    android:textColor="@color/black"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />

                            </LinearLayout>

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="0.5dp"
                                android:background="@color/lightGray" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:layout_weight="0.5"
                                    android:clickable="false"
                                    android:gravity="center"
                                    android:inputType="textMultiLine|textNoSuggestions"
                                    android:longClickable="false"
                                    android:padding="5dp"
                                    android:text="PEF"
                                    android:textColor="@color/black"
                                    android:textSize="14sp" />

                                <View
                                    android:layout_width="0.5dp"
                                    android:layout_height="match_parent"
                                    android:background="@color/lightGray" />

                                <TextView
                                    android:id="@+id/tv_pef"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="0.5"
                                    android:clickable="false"
                                    android:gravity="center"
                                    android:inputType="textMultiLine|textNoSuggestions"
                                    android:longClickable="false"
                                    android:padding="5dp"
                                    android:textColor="@color/black"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />

                            </LinearLayout>

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="0.5dp"
                                android:background="@color/lightGray" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:layout_weight="0.5"
                                    android:clickable="false"
                                    android:gravity="center"
                                    android:inputType="textMultiLine|textNoSuggestions"
                                    android:longClickable="false"
                                    android:padding="5dp"
                                    android:text="FEF 25-75%"
                                    android:textColor="@color/black"
                                    android:textSize="14sp" />

                                <View
                                    android:layout_width="0.5dp"
                                    android:layout_height="match_parent"
                                    android:background="@color/lightGray" />

                                <TextView
                                    android:id="@+id/tv_fef_25_65"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="0.5"
                                    android:clickable="false"
                                    android:gravity="center"
                                    android:inputType="textMultiLine|textNoSuggestions"
                                    android:longClickable="false"
                                    android:padding="5dp"
                                    android:textColor="@color/black"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />

                            </LinearLayout>

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="0.5dp"
                                android:background="@color/lightGray" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:layout_weight="0.5"
                                    android:clickable="false"
                                    android:gravity="center"
                                    android:inputType="textMultiLine|textNoSuggestions"
                                    android:longClickable="false"
                                    android:padding="5dp"
                                    android:text="FIVC"
                                    android:textColor="@color/black"
                                    android:textSize="14sp" />

                                <View
                                    android:layout_width="0.5dp"
                                    android:layout_height="match_parent"
                                    android:background="@color/lightGray" />

                                <TextView
                                    android:id="@+id/tv_fivc"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="0.5"
                                    android:clickable="false"
                                    android:gravity="center"
                                    android:inputType="textMultiLine|textNoSuggestions"
                                    android:longClickable="false"
                                    android:padding="5dp"
                                    android:textColor="@color/black"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />

                            </LinearLayout>

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="0.5dp"
                                android:background="@color/lightGray" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:layout_weight="0.5"
                                    android:clickable="false"
                                    android:gravity="center"
                                    android:inputType="textMultiLine|textNoSuggestions"
                                    android:longClickable="false"
                                    android:padding="5dp"
                                    android:text="PIF"
                                    android:textColor="@color/black"
                                    android:textSize="14sp" />

                                <View
                                    android:layout_width="0.5dp"
                                    android:layout_height="match_parent"
                                    android:background="@color/lightGray" />

                                <TextView
                                    android:id="@+id/tv_pif"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="0.5"
                                    android:clickable="false"
                                    android:gravity="center"
                                    android:inputType="textMultiLine|textNoSuggestions"
                                    android:longClickable="false"
                                    android:padding="5dp"
                                    android:textColor="@color/black"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />

                            </LinearLayout>

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="0.5dp"
                                android:background="@color/lightGray" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:layout_weight="0.5"
                                    android:clickable="false"
                                    android:gravity="center"
                                    android:inputType="textMultiLine|textNoSuggestions"
                                    android:longClickable="false"
                                    android:padding="5dp"
                                    android:text="FET"
                                    android:textColor="@color/black"
                                    android:textSize="14sp" />

                                <View
                                    android:layout_width="0.5dp"
                                    android:layout_height="match_parent"
                                    android:background="@color/lightGray" />

                                <TextView
                                    android:id="@+id/tv_fet"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="0.5"
                                    android:clickable="false"
                                    android:gravity="center"
                                    android:inputType="textMultiLine|textNoSuggestions"
                                    android:longClickable="false"
                                    android:padding="5dp"
                                    android:textColor="@color/black"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />

                            </LinearLayout>

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="0.5dp"
                                android:background="@color/lightGray" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:layout_weight="0.5"
                                    android:clickable="false"
                                    android:gravity="center"
                                    android:inputType="textMultiLine|textNoSuggestions"
                                    android:longClickable="false"
                                    android:padding="5dp"
                                    android:text="RESULT"
                                    android:textColor="@color/black"
                                    android:textSize="14sp" />

                                <View
                                    android:layout_width="0.5dp"
                                    android:layout_height="match_parent"
                                    android:background="@color/lightGray" />

                                <TextView
                                    android:id="@+id/tv_result"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="0.5"
                                    android:clickable="false"
                                    android:gravity="center"
                                    android:inputType="textMultiLine|textNoSuggestions"
                                    android:longClickable="false"
                                    android:padding="5dp"
                                    android:textColor="@color/black"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />

                            </LinearLayout>

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/spiroLayout"
                            android:layout_width="match_parent"
                            android:layout_height="250dp"
                            android:layout_gravity="center"
                            android:visibility="gone"
                            android:orientation="horizontal">

                        </LinearLayout>

                        <Button
                            android:id="@+id/btn_register"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_margin="20dp"
                            android:background="@drawable/button_gradent"
                            android:padding="10dp"
                            android:text="SUBMIT"
                            android:textColor="@color/white"
                            android:textSize="20sp" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>



            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>


</androidx.constraintlayout.widget.ConstraintLayout>