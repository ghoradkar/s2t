<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/llMain"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">


        <TextView
            android:id="@+id/distName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_weight="1.5"
            android:padding="2dp"
            android:text="Ahemadnagar"
            android:textColor="@color/black"
            android:textSize="12sp" />

        <TextView
            style="?android:attr/listSeparatorTextViewStyle"
            android:layout_width="0.5dp"
            android:layout_height="match_parent"
            android:background="@color/mediumGray"
            android:gravity="center_vertical" />

        <TextView
            android:id="@+id/tvTotalWorkers"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="2dp"
            android:text="856669"
            android:textColor="@color/black"
            android:textSize="12sp"

            />

        <TextView
            style="?android:attr/listSeparatorTextViewStyle"
            android:layout_width="0.5dp"
            android:layout_height="match_parent"
            android:background="@color/mediumGray"
            android:gravity="center_vertical" />

        <TextView
            android:id="@+id/tvMonthlyTargetToAchieved"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="2dp"
            android:text="2548"
            android:textColor="@color/black"
            android:textSize="12sp"

            />

        <TextView
            style="?android:attr/listSeparatorTextViewStyle"
            android:layout_width="0.5dp"
            android:layout_height="match_parent"
            android:background="@color/mediumGray"
            android:gravity="center_vertical" />

        <TextView
            android:id="@+id/tvMonthlyTargetAchieved"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="2dp"
            android:text="1234"
            android:textColor="@color/black"
            android:textSize="12sp"

            />

        <TextView
            style="?android:attr/listSeparatorTextViewStyle"
            android:layout_width="0.5dp"
            android:layout_height="match_parent"
            android:background="@color/mediumGray"
            android:visibility="gone"
            android:gravity="center_vertical" />


        <TextView
            android:id="@+id/tvMonthlyCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_weight="1"
            android:gravity="center"
            android:visibility="gone"
            android:padding="2dp"
            android:text="45987"
            android:textColor="@color/black"
            android:textSize="12sp"

            />

        <TextView
            style="?android:attr/listSeparatorTextViewStyle"
            android:layout_width="0.5dp"
            android:layout_height="match_parent"
            android:background="@color/mediumGray"
            android:gravity="center_vertical" />

        <TextView
            android:id="@+id/tvPerDayTarget"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="2dp"
            android:text="36589"
            android:textColor="@color/black"
            android:textSize="12sp"

            />

        <TextView
            style="?android:attr/listSeparatorTextViewStyle"
            android:layout_width="0.5dp"
            android:layout_height="match_parent"
            android:background="@color/mediumGray"
            android:gravity="center_vertical" />

        <TextView
            android:id="@+id/tvPerDayTargetAchieved"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="2dp"
            android:text="36589"
            android:textColor="@color/black"
            android:textSize="12sp"

            />

        <TextView
            style="?android:attr/listSeparatorTextViewStyle"
            android:layout_width="0.5dp"
            android:layout_height="match_parent"
            android:background="@color/mediumGray"
            android:gravity="center_vertical" />

        <TextView
            android:id="@+id/tvPercentage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="2dp"
            android:text="36589"
            android:textColor="@color/black"
            android:textSize="12sp"

            />

    </androidx.appcompat.widget.LinearLayoutCompat>


</androidx.appcompat.widget.LinearLayoutCompat>