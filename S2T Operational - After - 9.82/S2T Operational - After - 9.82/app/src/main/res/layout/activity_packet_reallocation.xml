<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tool="http://schemas.android.com/tools"
    android:background="@color/devider"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/AppTheme.AppBarOverlay">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/colorPrimary"
            android:orientation="horizontal">


            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:layout_weight="0.6"
                android:theme="@style/AppTheme.AppBarOverlay"
                app:layout_scrollFlags="scroll|enterAlways"
                app:popupTheme="@style/ThemeOverlay.AppCompat.Light" />

            <ImageView
                android:id="@+id/iv_info"
                android:layout_width="@dimen/_20sdp"
                android:layout_height="@dimen/_20sdp"
                android:layout_below="@+id/toolbar"
                android:layout_alignParentRight="true"
                android:layout_margin="10dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_info"
                android:visibility="visible"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/toolbar" />

        </LinearLayout>


    </com.google.android.material.appbar.AppBarLayout>

    <RadioGroup
        android:id="@+id/rg_selection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="5dp"
        android:orientation="horizontal"
        android:visibility="gone">


        <RadioButton
            android:id="@+id/rb_regId"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Search by reg no."
            android:visibility="visible" />

        <RadioButton
            android:id="@+id/rb_campId"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Search by campId"
            android:visibility="visible" />

    </RadioGroup>



    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        >


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="5dp"
        android:layout_marginTop="10dp"
        android:orientation="vertical"
        android:visibility="visible">



    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        android:layout_marginEnd="5dp"
        android:visibility="gone"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/campDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="5dp"
            android:layout_marginRight="5dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Camp Date*"
                android:textColor="@color/black"
                android:textColorHint="@color/black"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvDate"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/textview_border"
                android:drawableEnd="@drawable/icon_calendar"
                android:hint="Select Camp Date"
                android:padding="10dp"
                android:textSize="14sp" />

        </LinearLayout>


    </LinearLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        android:layout_marginEnd="5dp"
        android:visibility="gone"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/mainllCampType"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="5dp"
            android:layout_marginRight="5dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="CampType*"
                android:textColor="@color/black"
                android:textColorHint="@color/black"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvCampType"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/textview_border"
                android:drawableEnd="@drawable/icon_downarrowbk"
                android:hint="Select Camp Type"
                android:padding="10dp"
                android:textSize="14sp" />

        </LinearLayout>


    </LinearLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        android:layout_marginEnd="5dp"
        android:visibility="gone"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/mainllCampId"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="5dp"
            android:layout_marginRight="5dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="CampId*"
                android:textColor="@color/black"
                android:textColorHint="@color/black"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvCamp"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/textview_border"
                android:drawableEnd="@drawable/icon_downarrowbk"
                android:hint="Select CampId"
                android:padding="10dp"
                android:textSize="14sp" />

        </LinearLayout>


    </LinearLayout>



        <LinearLayout
            android:layout_width="350dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_gravity="center_horizontal"
            android:visibility="visible"
            android:background="@color/white">

            <RadioGroup
                android:id="@+id/rg_worker_Info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <RadioButton
                    android:id="@+id/rb_board"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingEnd="2.5dp"
                    android:background="@drawable/background_selected"
                    android:button="@null"

                    android:gravity="center"
                    android:textSize="14sp"
                    android:text="Return In Lab"
                    android:textColor="@color/black"/>

                <RadioButton
                    android:id="@+id/rb_manual"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/background_selected"
                    android:button="@null"
                    android:gravity="center"
                    android:checked="true"
                    android:paddingStart="2.5dp"
                    android:textSize="14sp"
                    android:text="Assign To DE / Team"
                    android:textColor="@color/black"/>
            </RadioGroup>

        </LinearLayout>




        <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">




    <LinearLayout
        android:id="@+id/mainLLDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="5dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginRight="2.5dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/from_date"
                android:textColor="@color/black"
                android:textColorHint="@color/black"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tv_from_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="5dp"
                android:background="@drawable/textview_outline"
                android:drawableRight="@drawable/calender"
                android:hint="Select From Date"
                android:textColor="@color/black" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="2.5dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/to_date"
                android:textColor="@color/black"
                android:textColorHint="@color/black"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tv_to_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="5dp"

                android:background="@drawable/textview_outline"
                android:drawableRight="@drawable/calender"
                android:hint="Select To Date"
                android:textColor="@color/black" />

        </LinearLayout>

    </LinearLayout>

    </LinearLayout>



    <LinearLayout
        android:id="@+id/llDistrict"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="5dp"
        android:visibility="visible">

        <LinearLayout
            android:id="@+id/LL_taluka"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginRight="2.5dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/Taluka"
                android:textColor="@color/black"
                android:textColorHint="@color/black"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tv_taluka"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/textview_outline"
                android:focusable="false"
                android:padding="7dp"
                android:hint="Select Taluka"
                android:drawableEnd="@drawable/ic_baseline_arrow_drop_down_24"
                android:longClickable="false"
                android:textColor="@color/black" />

        </LinearLayout>


        <LinearLayout
            android:id="@+id/LL_delivery_executive"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginRight="2.5dp"
            android:layout_weight="1"
            android:visibility="visible"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/delivery_executive"
                android:textColor="@color/black"
                android:textColorHint="@color/black"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tv_resourceNme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/textview_outline"
                android:focusable="false"
                android:drawableEnd="@drawable/ic_baseline_arrow_drop_down_24"
                android:padding="7dp"
                android:hint=""
                android:longClickable="false"
                android:textColor="@color/black" />

        </LinearLayout>


    </LinearLayout>



        <LinearLayout
            android:id="@+id/mainLL_search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:layout_marginRight="5dp"
            android:layout_marginTop="5dp"
            android:background="@color/white"
            android:orientation="horizontal"
            android:weightSum="1">


            <com.rengwuxian.materialedittext.MaterialEditText
                android:id="@+id/edt_barcode1"
                style="@style/CustomEdittext"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.8"
                android:hint="Scan packet or Delivery Challan No"
                android:textSize="14sp"
                app:met_floatingLabel="highlight"
                app:met_textColorHint="@color/black" />

            <ImageView
                android:id="@+id/imv_search"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:layout_weight="0.1"
                android:src="@drawable/baseline_search_24" />

            <ImageView
                android:id="@+id/imv_barcode1"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:layout_weight="0.1"
                android:src="@drawable/icon_barcode" />

        </LinearLayout>


        <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="5dp">



    </LinearLayout>



    <androidx.cardview.widget.CardView
        android:id="@+id/mainLL_searchView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="4dp"
        android:visibility="gone"
        app:cardElevation="5dp"
        app:cardUseCompatPadding="true"
        app:contentPadding="5dp">


        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:visibility="visible"
            android:layout_height="wrap_content">

            <SearchView
                android:id="@+id/searchview_campname"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_weight="0.9"
                android:focusable="false"
                android:iconifiedByDefault="false"
                android:queryBackground="@android:color/transparent"
                android:queryHint="Search Beneficiary"
                android:searchIcon="@null" />

            <ImageButton
                android:id="@+id/imvSearch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.1"
                android:background="@null"
                android:visibility="gone"
                android:src="@drawable/icon_search"
                app:tint="@color/black" />
        </androidx.appcompat.widget.LinearLayoutCompat>


    </androidx.cardview.widget.CardView>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primaryColor"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.1"
            android:gravity="center"
            android:padding="5dp"
            android:text="Sr. No."
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0.5dp"
            android:layout_height="match_parent"
            android:background="@color/white" />

        <CheckBox
            android:id="@+id/cb_accept"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@color/white"
            android:layout_gravity="center_vertical"
            android:visibility="visible" />


        <View
            android:layout_width="0.5dp"
            android:layout_height="match_parent"
            android:background="@color/white" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_weight="0.5"
            android:gravity="center"
            android:padding="5dp"
            android:text="Patient Name"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0.5dp"
            android:layout_height="match_parent"
            android:background="@color/white" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_weight="0.2"
            android:gravity="center"
            android:padding="5dp"
            android:text="Pack.No"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0.5dp"
            android:layout_height="match_parent"
            android:background="@color/white" />


        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_weight="0.2"
            android:gravity="center"
            android:padding="5dp"
            android:text="Delivery Challan No."
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0.5dp"
            android:layout_height="match_parent"
            android:background="@color/white" />


    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_patient_list"
        android:layout_width="match_parent"
        android:layout_height="420dp"
        android:background="@color/white"
        tool:listitem="@layout/list_row_package_assignment_new"/>


    <Button
        android:id="@+id/btn_accept_courier"
        android:layout_width="200dp"
        android:layout_height="50dp"
        android:text="Accept In Lab"
        android:layout_marginBottom="5dp"
        android:layout_gravity="center"
        android:textAllCaps="false">

    </Button>


    </LinearLayout>

    </ScrollView>

</LinearLayout>