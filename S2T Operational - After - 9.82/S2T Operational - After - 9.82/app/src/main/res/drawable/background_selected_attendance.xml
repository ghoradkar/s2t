<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Selected -->
    <item android:state_checked="true">
        <shape>
            <!-- SAME background -->
            <solid android:color="@color/light_primary"/>

            <!-- Border for selected -->
            <stroke
                android:width="0.5dp"
                android:color="@color/black"/>
        </shape>
    </item>

    <!-- Unselected -->
    <item>
        <shape>
            <!-- SAME background -->
            <solid android:color="@color/light_primary"/>

            <!-- Border for unselected -->
            <stroke
                android:width="0.5dp"
                android:color="@color/black"/>
        </shape>
    </item>

</selector>
