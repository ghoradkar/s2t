<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Checked State -->
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="#8B60C9"/>  <!-- Checked color -->
            <corners android:radius="12dp"/>  <!-- Rounded corners -->
            <size android:width="24dp" android:height="24dp"/>
        </shape>
    </item>

    <!-- Unchecked State -->
    <item android:state_checked="false">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/white"/>  <!-- Unchecked background -->
            <stroke android:width="2dp" android:color="#8B60C9"/>  <!-- Border color -->
            <corners android:radius="12dp"/>  <!-- Rounded corners -->
            <size android:width="24dp" android:height="24dp"/>
        </shape>
    </item>

</selector>
